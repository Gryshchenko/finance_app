{
    "name": "tenpercen",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "dependencies": {
        "luxon": "^3.6.1",
        "expo": "~54.0.33",
        "react": "19.1.0",
        "react-native": "0.81.5"
    },
    "devDependencies": {
        "@babel/core": "^7.20.0",
        "@babel/preset-env": "^7.20.0",
        "@babel/runtime": "^7.20.0",
        "@eslint/js": "9.39.4",
        "@types/jest": "^29.5.14",
        "@types/node": "20.11.0",
        "babel-jest": "^29.2.1",
        "eslint": "^9.39.4",
        "eslint-config-expo": "~9.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-native": "^5.0.0",
        "eslint-plugin-reactotron": "^0.1.2",
        "globals": "15.3.0",
        "husky": "^8.0.3",
        "jest": "~29.7.0",
        "jiti": "^2.5.1",
        "prettier": "^3.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "typescript": "~5.8.3",
        "typescript-eslint": "8.58.2"
    },
    "scripts": {
        "start:app": "pnpm --filter './packages/app' run start",
        "start:server": "pnpm --filter './packages/server' run start",
        "postinstall": "husky install",
        "prettier:write": "prettier \"**/*\" --write --ignore-unknown",
        "prettier:check": "prettier \"**/*\" --check --ignore-unknown",
        "eslint": "pnpm --filter './packages/server' run eslint && pnpm --filter './packages/app' run eslint && pnpm --filter './packages/shared' run eslint",
        "eslint:check": "pnpm --filter './packages/server' run eslint:check && pnpm --filter './packages/app' run eslint:check && pnpm --filter './packages/shared' run eslint:check",
        "prepare": "husky install",
        "android": "expo run:android",
        "ios": "expo run:ios"
    },
    "pnpm": {
        "neverBuiltDependencies": [
            "react-native"
        ],
        "publicHoistPattern": []
    },
    "version": "1.0.0"
}
