{
    "version": "1.0.0",
    "name": "tenpercent",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "dependencies": {
        "luxon": "^3.6.1"
    },
    "devDependencies": {
        "@babel/core": "^7.20.0",
        "@babel/preset-env": "^7.20.0",
        "@babel/runtime": "^7.20.0",
        "@changesets/cli": "^3.0.1",
        "@eslint/js": "9.39.4",
        "@types/jest": "^29.5.14",
        "@types/node": "20.11.0",
        "babel-jest": "^29.2.1",
        "eslint": "^9.39.4",
        "eslint-config-expo": "~9.2.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-native": "^5.0.0",
        "eslint-plugin-reactotron": "^0.1.2",
        "globals": "15.3.0",
        "husky": "^8.0.3",
        "jest": "~29.7.0",
        "jiti": "^2.5.1",
        "prettier": "^3.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "typescript": "~5.8.3",
        "typescript-eslint": "8.58.2"
    },
    "scripts": {
        "start:app": "pnpm --filter './packages/app' run start",
        "start:server": "pnpm --filter './packages/server' run start",
        "postinstall": "husky install",
        "changeset": "changeset",
        "changeset:version": "changeset version",
        "changeset:status": "changeset status",
        "prettier:write": "prettier \"**/*\" --write --ignore-unknown",
        "prettier:check": "prettier \"**/*\" --check --ignore-unknown",
        "eslint": "pnpm --filter './packages/server' run eslint && pnpm --filter './packages/app' run eslint && pnpm --filter './packages/shared' run eslint",
        "eslint:check": "pnpm --filter './packages/server' run eslint:check && pnpm --filter './packages/app' run eslint:check && pnpm --filter './packages/shared' run eslint:check",
        "prepare": "husky install",
        "android": "pnpm --filter './packages/app' run android",
        "ios": "pnpm --filter './packages/app' run ios"
    },
    "pnpm": {
        "neverBuiltDependencies": [
            "react-native"
        ],
        "publicHoistPattern": []
    },
    "packageManager": "pnpm@8.15.9+sha512.499434c9d8fdd1a2794ebf4552b3b25c0a633abcee5bb15e7b5de90f32f47b513aca98cd5cfd001c31f0db454bc3804edccd578501e4ca293a6816166bbd9f81"
}
