{
    "name": "tenpercen",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "dependencies": {
        "luxon": "^3.6.1"
    },
    "devDependencies": {
        "@babel/core": "^7.20.0",
        "@babel/preset-env": "^7.20.0",
        "@babel/runtime": "^7.20.0",
        "@eslint/js": "9.4.0",
        "@types/jest": "^29.5.14",
        "babel-jest": "^29.2.1",
        "eslint": "9.39.2",
        "eslint-config-expo": "~9.2.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.2.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-native": "^4.1.0",
        "eslint-plugin-reactotron": "^0.1.2",
        "globals": "15.3.0",
        "husky": "^8.0.3",
        "jest": "~29.7.0",
        "jiti": "^2.5.1",
        "prettier": "^3.3.3",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.2",
        "typescript": "~5.8.3",
        "typescript-eslint": "8.33.0"
    },
    "scripts": {
        "start:app": "pnpm --filter './packages/app' run start",
        "start:server": "pnpm --filter './packages/server' run start",
        "postinstall": "husky install",
        "prettier:write": "prettier \"**/*\" --write --ignore-unknown",
        "prettier:check": "prettier \"**/*\" --check --ignore-unknown",
        "eslint": "pnpm --filter './packages/server' run lint && pnpm --filter './packages/app' run lint",
        "eslint:check": "eslint --ext .js,.ts packages/",
        "prepare": "husky install"
    },
    "pnpm": {
        "neverBuiltDependencies": [
            "react-native"
        ],
        "publicHoistPattern": []
    }
}
