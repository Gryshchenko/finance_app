{
    "name": "@tenpercent/server",
    "author": "Volodymyr Gryshchenko",
    "description": "К",
    "version": "0.0.1",
    "private": true,
    "copyright": "",
    "scripts": {
        "build": "tsc --project tsconfig.build.json && tscpaths -p tsconfig.json -s . -o ./dist",
        "build:dev": "tsc --project tsconfig.json && tscpaths -p tsconfig.json -s . -o ./dist",
        "build-translation": "node scripts/translations.js",
        "start": "pnpm run build-translation && NODE_ENV=development nodemon --exec NODE_OPTIONS='--inspect' ts-node --files src/app.ts",
        "redis": "sudo service redis-server start",
        "type-check": "tsc -v && tsc -p tsconfig.json",
        "eslint": "npx eslint src/ --fix",
        "eslint:check": "npx eslint src/",
        "jest-test": "jest --verbose false --config ./jest.config.js --no-cache --detectOpenHandles",
        "jest-test:unit": "jest --verbose false --config ./jest.unit.config.js --no-cache",
        "jest-test:integration": "jest --verbose false --config ./jest.integration.config.js --no-cache",
        "jest-test:all": "jest --verbose false --config ./jest.unit.config.js --no-cache && jest --verbose false --config ./jest.integration.config.js --no-cache --detectOpenHandles",
        "jest-test:coverage": "jest --verbose false --config ./jest.config.js --no-cache --coverage",
        "lint-staged": "lint-staged"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "license": "All rights reserved",
    "dependencies": {
        "@aws-sdk/client-sesv2": "^3.700.0",
        "@tenpercent/shared": "workspace:*",
        "apple-signin-auth": "^2.0.0",
        "argon2": "0.40.3",
        "axios": "^1.9.0",
        "connect-redis": "7.1.1",
        "cors": "^2.8.5",
        "crypto-js": "4.2.0",
        "dotenv": "16.3.1",
        "express": "^4.21.2",
        "express-rate-limit": "7.2.0",
        "express-session": "^1.18.1",
        "express-validator": "7.0.1",
        "google-auth-library": "^10.6.2",
        "graphql": "16.8.1",
        "helmet": "7.1.0",
        "https": "1.0.0",
        "ioredis": "^5.7.0",
        "jsonwebtoken": "9.0.2",
        "knex": "3.1.0",
        "passport": "0.7.0",
        "passport-jwt": "4.0.1",
        "pg": "8.11.5",
        "pino": "9.7.0",
        "pino-pretty": "13.0.0",
        "rate-limiter-flexible": "^11.2.0",
        "redis": "4.6.12",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "ts-jest": "29.1.2",
        "ua-parser-js": "2.0.0-beta.3"
    },
    "devDependencies": {
        "@eslint/js": "9.39.4",
        "@types/eslint__js": "8.42.3",
        "@types/express": "4.17.21",
        "@types/express-session": "1.17.10",
        "@types/jest": "29.5.12",
        "@types/jsonwebtoken": "9.0.5",
        "@types/node": "20.11.0",
        "@types/passport": "1.0.16",
        "@types/passport-jwt": "4.0.1",
        "@types/pg": "8.11.0",
        "@types/supertest": "6.0.2",
        "@types/ua-parser-js": "^0.7.39",
        "@types/useragent": "2.3.4",
        "chai": "5.1.1",
        "child_process": "1.0.2",
        "cookie": "^1.0.2",
        "eslint": "^9.39.4",
        "eslint-config-airbnb-base": "15.0.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "3.10.1",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-node": "11.1.0",
        "eslint-plugin-prettier": "5.5.5",
        "eslint-plugin-security": "^3.0.1",
        "express-openapi": "^12.1.3",
        "globals": "15.3.0",
        "husky": "^8.0.0",
        "jest": "29.7.0",
        "jest-html-reporters": "^3.1.7",
        "lint-staged": "^15.5.2",
        "mocha": "^10.8.2",
        "mock-knex": "0.4.13",
        "nodemon": "3.0.3",
        "prettier": "^3.2.5",
        "supertest": "7.0.0",
        "ts-node": "10.9.2",
        "tsconfig-paths": "4.2.0",
        "tscpaths": "^0.0.9",
        "tslib": "2.6.2",
        "typescript": "5.3.3",
        "typescript-eslint": "8.58.2"
    }
}
