# Copy to `.env` and fill in. `.env` is gitignored.
#
# This file is for LOCAL runs only. `.env` is not committed, so it is not part of what EAS
# uploads, and a cloud build never sees it. Values a build needs live in EAS instead, per
# environment (`development` / `preview` / `production` - eas.json picks one per profile):
#
#   npx eas-cli env:create --environment production --name EXPO_PUBLIC_SENTRY_DSN --value '<dsn>'
#   npx eas-cli env:list --environment production
#
# Anything constant across builds of one environment is already written into eas.json's
# `env` block and does not need to be created there.
#
# EXPO_PUBLIC_ variables are inlined into the JS bundle by Metro, so treat every value here
# as public - anyone who downloads the app can read them back out. See app/config/index.ts.

# Sentry project DSN. Leave empty to turn error reporting off entirely.
# A DSN is not a secret: it only grants permission to write events.
EXPO_PUBLIC_SENTRY_DSN=

# Tags events so production noise can be filtered out of a staging release. eas.json sets
# this per build profile; the value here only applies to a local `expo start`.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development

# Fraction of sessions kept as performance traces. Traces are billed per span.
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Build-time only - NOT prefixed with EXPO_PUBLIC_, never reaches the bundle.
# ---------------------------------------------------------------------------
# Lets the build upload source maps, without which a production stack trace is unreadable
# minified JS. This one IS a secret - store it in EAS as a sensitive variable rather than
# committing it:
#
#   npx eas-cli env:create --environment production --name SENTRY_AUTH_TOKEN \
#       --value '<token>' --visibility sensitive
SENTRY_AUTH_TOKEN=
