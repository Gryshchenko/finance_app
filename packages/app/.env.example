# Copy to `.env` and fill in. `.env` is gitignored.
#
# EXPO_PUBLIC_ variables are inlined into the JS bundle by Metro, so treat every
# value here as public - anyone who downloads the app can read them back out.
# See app/config/index.ts.

# Sentry project DSN. Leave empty to turn error reporting off entirely.
# A DSN is not a secret: it only grants permission to write events.
EXPO_PUBLIC_SENTRY_DSN=

# Tags events so production noise can be filtered out of a staging release.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=development

# Fraction of sessions kept as performance traces. Traces are billed per span.
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------------------------------------------------------------------
# Build-time only - NOT prefixed with EXPO_PUBLIC_, never reaches the bundle.
# ---------------------------------------------------------------------------
# Lets the build upload source maps, without which a production stack trace is
# unreadable minified JS. This one IS a secret: store it as an EAS secret
# (`eas secret:create --name SENTRY_AUTH_TOKEN`) rather than committing it.
SENTRY_AUTH_TOKEN=
