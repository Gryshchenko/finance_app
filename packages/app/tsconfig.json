{
    "extends": "expo/tsconfig.base",
    "compilerOptions": {
        "composite": true,
        "allowJs": false,
        "emitDeclarationOnly": true,
        "allowSyntheticDefaultImports": true,
        "experimentalDecorators": true,
        "jsx": "react-native",
        "customConditions": ["react-native"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "sourceMap": true,
        "target": "esnext",
        "lib": ["esnext", "dom"],
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./app/*"],
            "@assets/*": ["./assets/*"],
            "@types/*": ["./types/*"]
        },
        "typeRoots": ["./node_modules/@types", "./types"]
    },
    "ts-node": {
        "compilerOptions": {
            "module": "commonjs"
        }
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules", "test/**/*", "**/Pods", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts"],
    "references": [{ "path": "../shared" }]
}
