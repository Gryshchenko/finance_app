{
    "name": "@tenpercent/app",
    "version": "0.0.1",
    "private": true,
    "main": "index.tsx",
    "scripts": {
        "start": "expo start --dev-client",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "web": "expo start --web",
        "bundle:web": "npx expo export --platform web",
        "serve:web": "npx serve dist",
        "prebuild:clean": "npx expo prebuild --clean",
        "compile": "tsc --noEmit -p . --pretty",
        "eslint": "npx eslint src/",
        "align-deps": "npx expo install --fix",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:maestro": "maestro test -e MAESTRO_APP_ID=com.tenpercent .maestro/flows",
        "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081",
        "build:ios:sim": "eas build --profile development --platform ios --local",
        "build:ios:dev": "eas build --profile development:device --platform ios --local",
        "build:ios:preview": "eas build --profile preview --platform ios --local",
        "build:ios:prod": "eas build --profile production --platform ios --local",
        "build:android:sim": "eas build --profile development --platform android --local",
        "build:android:dev": "eas build --profile development:device --platform android --local",
        "build:android:preview": "eas build --profile preview --platform android --local",
        "build:android:prod": "eas build --profile production --platform android --local",
        "precheck": "pnpm run prettier:check && pnpm run eslint:check && pnpm run type-check"
    },
    "dependencies": {
        "@babel/plugin-proposal-export-namespace-from": "^7.18.9",
        "@expo-google-fonts/funnel-sans": "0.4.2",
        "@expo-google-fonts/space-grotesk": "^0.4.0",
        "@expo/metro-runtime": "~6.1.2",
        "@gorhom/portal": "^1.0.14",
        "@react-native-async-storage/async-storage": "^2.2.0",
        "@react-native-community/cli": "20.0.0",
        "@react-native-community/cli-platform-android": "20.0.0",
        "@react-native-community/cli-platform-ios": "20.0.0",
        "@react-native-community/datetimepicker": "^8.4.4",
        "@react-native/babel-preset": "0.81.5",
        "@react-native/eslint-config": "0.81.5",
        "@react-native/metro-config": "0.81.5",
        "@react-native/new-app-screen": "0.81.5",
        "@react-native/typescript-config": "0.81.5",
        "@react-navigation/bottom-tabs": "^7.2.0",
        "@react-navigation/native": "^7.0.14",
        "@react-navigation/native-stack": "^7.2.0",
        "@shopify/flash-list": "1.8.1",
        "@tanstack/react-query": "^5.89.0",
        "@types/react": "^19.1.0",
        "@types/react-test-renderer": "^19.1.0",
        "apisauce": "3.1.1",
        "date-fns": "^4.1.0",
        "expo": "54.0.33",
        "expo-application": "~7.0.8",
        "expo-build-properties": "~1.0.10",
        "expo-dev-client": "~6.0.20",
        "expo-font": "~14.0.11",
        "expo-linking": "~8.0.11",
        "expo-local-authentication": "~17.0.8",
        "expo-localization": "~17.0.8",
        "expo-secure-store": "~15.0.8",
        "expo-splash-screen": "~31.0.13",
        "expo-system-ui": "~6.0.9",
        "i18next": "^23.14.0",
        "intl-pluralrules": "^2.0.1",
        "react": "19.1.0",
        "react-dom": "19.1.0",
        "react-i18next": "^15.0.1",
        "react-native": "0.81.5",
        "react-native-confirmation-code-field": "^8.0.1",
        "react-native-drawer-layout": "4.2.1",
        "react-native-edge-to-edge": "1.6.0",
        "react-native-gesture-handler": "~2.28.0",
        "react-native-keyboard-controller": "1.18.5",
        "react-native-keychain": "^10.0.0",
        "react-native-mmkv": "4.1.2",
        "react-native-nitro-modules": "^0.33.2",
        "react-native-reanimated": "^4.1.6",
        "react-native-reanimated-dnd": "^1.1.0",
        "react-native-safe-area-context": "^5.5.2",
        "react-native-screens": "~4.16.0",
        "react-native-sortables": "^1.9.4",
        "react-native-super-grid": "^6.0.2",
        "react-native-web": "^0.21.2",
        "react-native-worklets": "^0.5.1",
        "react-test-renderer": "19.1.0",
        "tenpercent/shared": "workspace:*",
        "toastify-react-native": "^7.2.3",
        "typescript": "^5.9.2",
        "yup": "^1.7.1"
    },
    "devDependencies": {
        "@testing-library/react-native": "^13.2.0",
        "@types/jest": "^29.5.14",
        "@types/react": "~19.1.17",
        "babel-jest": "^29.7.0",
        "jest": "29.7.0",
        "jest-expo": "~54.0.17",
        "react-test-renderer": "19.0.0",
        "reactotron-core-client": "2.9.9",
        "reactotron-react-js": "3.3.17",
        "reactotron-react-native": "5.1.18",
        "reactotron-react-native-mmkv": "0.2.9"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "expo": {
        "install": {
            "exclude": [
                "@shopify/flash-list"
            ]
        }
    }
}
