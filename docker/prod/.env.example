# Copy to docker/prod/.env on the instance and fill in. Compose picks `.env` up
# automatically from the directory of the compose file - no --env-file needed.
#
#   cp docker/prod/.env.example docker/prod/.env && chmod 600 docker/prod/.env
#
# .env is gitignored. Never commit the filled-in copy.

# ====================
# TLS / Caddy
# ====================
# Must already resolve to this instance's public IP - Let's Encrypt verifies it
# over HTTP-01 before issuing anything.
API_DOMAIN=api.example.com
# Where Let's Encrypt sends expiry warnings if renewal ever stalls.
ACME_EMAIL=you@example.com

# ====================
# App
# ====================
APP_NAME=tenpercent
ORIGIN=https://api.example.com
LOG_LEVEL=info
PORT=3000

# ====================
# JWT - generate each one separately: openssl rand -hex 64
# ====================
# JWT_RESET_SECRET has to differ from JWT_SECRET, otherwise a password-reset
# token doubles as a full session token.
JWT_SECRET=
JWT_LONG_SECRET=
JWT_RESET_SECRET=
JWT_ISSUER=tenpercent
JWT_AUDIENCE=tenpercent.app
JWT_ALGORITHM=HS384
JWT_EXPIRES_IN=1h
JWT_LONG_EXPIRES_IN=30d
JWT_RESET_EXPIRES_IN=15m

# ====================
# PostgreSQL
# ====================
# DB_HOST/DB_PORT/DB_SSL are left out on purpose: the compose defaults already
# point at the bundled container over the internal network, where TLS buys
# nothing. Set all three only when moving to a managed database.
DB_NAME=tenpercent
DB_USER=appuser
DB_PASS=

# ====================
# Redis
# ====================
# REDIS_USERNAME stays empty: `requirepass` defines no ACL user.
REDIS_PASSWORD=
REDIS_USERNAME=
REDIS_PREFIX=tp:

# ====================
# Mail + AWS
# ====================
# Leave AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY unset when the instance runs
# with an IAM role - the SDK picks the role up by itself, and there is no static
# key on disk to leak.
MAIL_PROVIDER=
MAIL_API_KEY=
MAIL_NO_REPLY=no-reply@example.com
AWS_REGION=eu-central-1

# ====================
# Third party
# ====================
RATE_PROVIDER_API=
RATE_PROVIDER_URL=
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
