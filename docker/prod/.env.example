# Copy to docker/prod/.env on the instance and fill in. Compose picks `.env` up
# automatically from the directory of the compose file - no --env-file needed.
#
#   cp docker/prod/.env.example docker/prod/.env && chmod 600 docker/prod/.env
#
# .env is gitignored. Never commit the filled-in copy.
#
# Legend:
#   [required] - the stack refuses to start without it (compose has a `:?` guard)
#   [fill]     - no guard, but the feature it drives is broken/off while empty
#   [default]  - safe to leave as is; listed so the value is visible in one place
#
# Every value here is read at container start. Changing one means recreating the
# affected container (`docker compose up -d --force-recreate <service>`) - except
# DB_PASS, which is also baked into the postgres volume on first init and needs an
# ALTER USER as well (see the PostgreSQL section).

# ====================
# TLS / Caddy
# ====================
# [required] Must already resolve to this instance's public IP - Let's Encrypt
# verifies it over HTTP-01 before issuing anything.
API_DOMAIN=api.example.com
# [required] Where Let's Encrypt sends expiry warnings if renewal ever stalls.
ACME_EMAIL=you@example.com

# ====================
# Image
# ====================
# [default] Which image the server service runs. Leave as is to build locally
# (`docker compose build`); point at a registry path + immutable tag once images
# are built in CI, so a rollback is a tag change rather than a rebuild.
SERVER_IMAGE=tenpercent-server
SERVER_IMAGE_TAG=latest

# ====================
# App
# ====================
# [default] APP_NAME shows up in logs and outgoing mail.
APP_NAME=tenpercent
# [fill] Currently read into config as `trustedOrigin` but not consumed anywhere
# in src - there is no CORS middleware yet. Set it to the public API origin so it
# is already correct when one is added.
ORIGIN=https://api.example.com
# [default] pino level: trace|debug|info|warn|error|fatal.
LOG_LEVEL=info
# [default] Internal port only - never published, caddy proxies to it.
PORT=3000

# ====================
# JWT - generate each one separately: openssl rand -hex 64
# ====================
# [required] All three. JWT_RESET_SECRET has to differ from JWT_SECRET, otherwise
# a password-reset token doubles as a full session token.
# Rotating any of these invalidates every token signed with the old value, i.e.
# it logs everyone out.
JWT_SECRET=
JWT_LONG_SECRET=
JWT_RESET_SECRET=
# [default] Issuer/audience are claims checked on verify - changing them after
# launch also invalidates existing tokens.
JWT_ISSUER=tenpercent
JWT_AUDIENCE=tenpercent.app
JWT_ALGORITHM=HS384
JWT_EXPIRES_IN=1h
JWT_LONG_EXPIRES_IN=30d
JWT_RESET_EXPIRES_IN=15m

# ====================
# PostgreSQL
# ====================
# [required] These three seed the bundled container on its FIRST start (empty
# volume): the entrypoint creates the role and database, then runs
# ../local/db/schema.sql. The server then connects with the same values.
#
# On every later start POSTGRES_PASSWORD is ignored - the password lives in the
# volume. To rotate it, change it in both places:
#   docker compose exec postgres psql -U "$DB_USER" -d "$DB_NAME" \
#     -c "ALTER USER \"$DB_USER\" WITH PASSWORD 'new';"
#   # then update DB_PASS here and: docker compose up -d --force-recreate server
DB_NAME=tenpercent
DB_USER=appuser
DB_PASS=
# [default] The compose defaults already point at the bundled container over the
# internal network, where TLS buys nothing. Uncomment and set all three only when
# moving to a managed database - DB_SSL=true verifies the chain, so the provider's
# CA has to reach Node through NODE_EXTRA_CA_CERTS.
# DB_HOST=postgres
# DB_PORT=5432
# DB_SSL=false

# ====================
# Redis
# ====================
# [required] Holds the token blacklist and sessionsValidFrom, not a throwaway
# cache. Unlike postgres, this password is applied on every start, so rotating it
# is just: edit here, then `up -d --force-recreate redis server`.
REDIS_PASSWORD=
# [default] Stays empty: `requirepass` defines no ACL user, so ioredis
# authenticates with the password alone.
REDIS_USERNAME=
# [default] Key namespace. Changing it orphans every existing key.
REDIS_PREFIX=tp:
# [default] Bundled container over the internal network. Set only when moving to
# a managed Redis.
# REDIS_HOST=redis
# REDIS_PORT=6379

# ====================
# Mail + AWS
# ====================
# [default] `aws` is the only implemented provider (MailProviderBuilder.ts); any
# other value falls through to SES anyway.
MAIL_PROVIDER=aws
# [default] Unused by the SES provider - it authenticates with the AWS credentials
# below. Kept for a future API-key based provider.
MAIL_API_KEY=
# [fill] From address on verification and password-reset mail. Must be a verified
# identity in SES, or sending fails.
MAIL_NO_REPLY=no-reply@example.com
# [fill] Region of the SES identity.
AWS_REGION=eu-central-1
# [fill] Leave both unset when the instance runs with an IAM role - the SDK picks
# the role up by itself, and there is no static key on disk to leak. Fill them
# only when running somewhere without instance roles.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ====================
# Third party
# ====================
# [fill] freecurrencyapi.com key and base URL - currency conversion throws
# without them (FreeCurrencyApi.ts checks both before every call).
RATE_PROVIDER_API=
RATE_PROVIDER_URL=https://api.freecurrencyapi.com/v1
# [fill] OAuth client ids used to verify the id tokens the app sends on social
# login. Leave empty to keep that login method off.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ====================
# Sentry
# ====================
# [fill] An empty DSN leaves the SDK uninitialised and every capture a no-op, so
# the stack still comes up without a Sentry project.
SENTRY_DSN=
# [default]
SENTRY_ENVIRONMENT=production
# [fill] The deployed git sha - it is what ties an event back to the code that
# raised it. Best set by the deploy script rather than committed here:
#   SENTRY_RELEASE=$(git rev-parse --short HEAD)
SENTRY_RELEASE=
# [default] Traces are billed per span; keep this low in production, 1.0 only
# while actively debugging.
SENTRY_TRACES_SAMPLE_RATE=0.1

# ====================
# Metrics
# ====================
# [default] Prometheus text format on a port of its own (src/metrics/metricsServer.ts).
# Deliberately not on PORT: caddy proxies every path of the public site to PORT,
# so `/metrics` there would be world-readable. The port is exposed to the compose
# network only, so leaving this on costs nothing.
METRICS_ENABLED=true
METRICS_PORT=9464

# ====================
# Grafana Cloud - only needed with compose.monitoring.yaml
# ====================
#   docker compose -f compose.yaml -f compose.monitoring.yaml up -d
#
# [required] for that command, ignored otherwise. From the Grafana Cloud portal:
# Connections -> Prometheus -> Send metrics. The token needs the `metrics:write`
# scope and nothing else.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_API_KEY=
