{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "composite": true,
        "baseUrl": ".",
        "paths": {
            "@tenpercent/shared": ["packages/shared/src"]
        },
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "types": []
    },
    "extends": "expo/tsconfig.base",
    "exclude": ["packages", "node_modules"]
}
